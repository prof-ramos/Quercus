# Configurações do Quercus para Deploy

# Token do Bot gerado pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Lista de IDs numéricos autorizados a interagir com o bot (separados por vírgula)
TELEGRAM_ALLOWED_USER_IDS=123456789

# Identificador canônico do aluno
QUERCUS_USER_ID=gabriel

# Caminhos de persistência e backup (valores padrão para Docker)
QUERCUS_DB_PATH=/app/data/quercus.db
QUERCUS_BACKUP_DIR=/app/backups
QUERCUS_BACKUP_RETENTION_DAYS=7
